# AEGIS Environment Configuration Example
# Copy this file to .env and configure for local development
# NEVER COMMIT ACTUAL SECRETS OR SENSITIVE AWS CREDENTIALS

# Application Settings
AEGIS_ENV=development
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=INFO

# AWS Target Scope (Strictly Read-Only)
AWS_DEFAULT_REGION=us-east-1
AEGIS_ALLOWED_REGIONS=us-east-1,us-east-2,us-west-2
AEGIS_TARGET_ACCOUNT_ID=237657481511

# Discovery & Mode Settings
# Set to 'true' to use local synthetic fixtures (zero AWS cost)
AEGIS_USE_SYNTHETIC_FIXTURES=true
# Set to 'false' to strictly forbid any network mutation API
AEGIS_READ_ONLY_ENFORCEMENT=true

# Bedrock AgentCore Settings
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Context Completeness Thresholds
AEGIS_SNAPSHOT_MAX_AGE_HOURS=24
AEGIS_MIN_COLLECTOR_SUCCESS_RATE=0.85
